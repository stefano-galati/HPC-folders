Bootstrap: docker
From: ubuntu:22.04

%files
	./../myGem5	/myGem5
	./../faultInjector	/faultInjector

%environment
	DEBIAN_FRONTEND=noninteractive 
	TZ=Europe/Rome

%post
	export DEBIAN_FRONTEND=noninteractive 
	export TZ=Europe/Rome
	apt update -y
	apt install -y build-essential git m4 scons zlib1g zlib1g-dev \
        libprotobuf-dev protobuf-compiler libprotoc-dev libgoogle-perftools-dev \
        python3-dev libboost-all-dev pkg-config python3-tk bc
    cd /myGem5
    rm -rf build
    scons build/RISCV/gem5.opt -j2
	
%runscript
	echo "Hello world"
	cd /faultInjector
	./faultInjector.sh
